# The production relay: one workerd, behind nginx (TLS on 443). No dev server or watch process.
# Install: cp ash-relay.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now ash-relay
# /etc/default/ash-relay sets ASH_RELAY_PUBLIC: the address clients use (an IP or a host name), without https://.
[Unit]
Description=ash relay (ash-gw/1 on workerd)
After=network-online.target
[Service]
EnvironmentFile=-/etc/default/ash-relay
EnvironmentFile=/opt/ash-relay/.dev.vars
WorkingDirectory=/opt/ash-relay/current
# workerd.capnp retains the old namespace and /var/lib/ash-relay/v3/do storage.
ExecStart=/opt/ash-relay/node_modules/.bin/workerd serve --experimental workerd.capnp
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
OOMPolicy=kill
# Measured runtime baseline is tens of MiB; leave room for sockets and bounded frames.
MemoryMax=256M
MemorySwapMax=0
[Install]
WantedBy=multi-user.target
